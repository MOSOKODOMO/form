# Copy this file to .env (which git ignores) and fill in what you use. Never commit .env.
# Optional: lets tools/add-product.py ask an LLM to read page text into fields.
# Every value it returns must appear in the page text, or it is written as "not stated".
OPENROUTER_API_KEY=
# Optional: the OpenRouter model to use (see openrouter.ai/models).
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
